# Intercom access token. Keep this empty in the shared example file.
INTERCOM_ACCESS_TOKEN=

# Reserved compatibility setting; the MCP exporter currently does not use it.
INTERCOM_API_VERSION=2.17

# Optional date bounds (UTC, YYYY-MM-DD). END_DATE is exclusive.
# START_DATE=
# END_DATE=

# Selection mode: new, updated, or all (default: all).
# EXPORT_TYPE=all
